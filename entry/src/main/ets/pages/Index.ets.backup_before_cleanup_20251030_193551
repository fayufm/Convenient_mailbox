  async onGenerateMailbox() {
    const timer = this.performanceMonitor.startTiming('generate_mailbox')
    
    try {
      if (this.createMode === 'random') {
        // 浣跨敤鏂扮殑async鏂规硶
        const duration = this.selectedDuration === -1  7 : this.selectedDuration
        const mailbox = await this.mailboxManager.generateRandomMailbox(duration, this.selectedDomain)
        this.currentMailbox = mailbox
      } else {
        // 鑷畾涔夌敓鎴愰€昏緫
        if (!this.customPrefix || this.customPrefix.length < 3) {
          await this.systemService.showToast(this.uiTexts['tipPrefixTooShort'])
          return
        }
        const duration = this.selectedDuration === -1  7 : this.selectedDuration
        const domain = this.selectedDomain === 'random'  
          this.domainManager.getRandomDomain(true) : this.selectedDomain
        const mailbox = await this.mailboxManager.createCustomMailbox(this.customPrefix, domain, duration)
        
        if (mailbox) {
          this.currentMailbox = mailbox
        } else {
          await this.systemService.showToast(this.uiTexts['tipCreateFailedCheck'])
          return
        }
      }
      
      this.loadData()
      this.updateStats()
      this.updateBadges()
      
      // 鏄剧ず鎴愬姛鎻愮ず
      const hasAPI = this.domainManager.hasAPISupport(this.currentMailbox.domain || '')
      if (hasAPI) {
        await this.systemService.showToast(this.uiTexts['tipMailboxCreatedReceivable'])
      } else {
        await this.systemService.showToast(this.uiTexts['tipMailboxCreatedAddressOnly'])
      }
      
      timer.end()
    } catch (error) {
      const err = error as Error
      timer.endWithError(err.message)
      await this.systemService.showToast(this.uiTexts['tipCreateFailedError'] + err.message)
    }
  }
  
