  async onSendEmail() {
    // 鉁?骞跺彂鍙戦€侀槻鎶わ細闃叉閲嶅鐐瑰嚮
    if (this.isSendingEmail) {
      await this.systemService.showToast(this.uiTexts['tipSendingInProgress'])
      hilog.warn(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG, '娴嬪埌閲姹傦紝叉嫆缁')
      return
    }
    
    // 楠岃瘉杈撳叆锛堝幓闄ょ┖鏍煎悗妫€鏌ワ級
    const toTrimmed = this.composeTo  this.composeTo.trim() : ''
    const subjectTrimmed = this.composeSubject  this.composeSubject.trim() : ''
    const bodyTrimmed = this.composeBody  this.composeBody.trim() : ''
    
    if (!toTrimmed || !subjectTrimmed || !bodyTrimmed) {
      await this.systemService.showToast(this.uiTexts['tipFillAllFields'])
      hilog.warn(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG, 
        '侀獙璇佸け璐 to=%{public}s, subject=%{public}s, body=%{public}s', 
        toTrimmed  '插～鍐 : '绌, subjectTrimmed  '插～鍐 : '绌, bodyTrimmed  '插～鍐 : '绌')'      return
    }
    
    // 鉁?楠岃瘉閭鏍煎紡锛堜娇鐢ㄦ洿涓ユ牸鐨勯獙璇侊級
    if (!this.validateEmailFormat(toTrimmed)) {
      await this.systemService.showToast(this.uiTexts['tipInvalidEmailFormat'])
      // 鉁?鏃ュ織鑴辨晱锛氬彧璁板綍鏍煎紡閿欒锛屼笉璁板綍瀹屾暣閭
      hilog.warn(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG, 
        '鏀朵洪辨牸寮忎笉姝ｇ‘锛堜弗鏍奸獙璇侊級')
      return
    }
    
    // 鉁?楠岃瘉鍐呭闀垮害闄愬埗
    const MAX_SUBJECT_LENGTH = 200
    const MAX_BODY_LENGTH = 10000
    
    if (subjectTrimmed.length > MAX_SUBJECT_LENGTH) {
      // 鉁?浼樺寲锛氫娇鐢ㄥ浗闄呭寲鏂囨湰锛屾敮鎸佸崰浣嶇鏇挎崲
      const message = this.uiTexts['tipSubjectTooLong'].replace('{max}', MAX_SUBJECT_LENGTH.toString())
      await this.systemService.showToast(message)
      hilog.warn(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG, 
        '婚闀垮害瓒呴檺: %{public}d > %{public}d', subjectTrimmed.length, MAX_SUBJECT_LENGTH)
      return
    }
    
    if (bodyTrimmed.length > MAX_BODY_LENGTH) {
      // 鉁?浼樺寲锛氫娇鐢ㄥ浗闄呭寲鏂囨湰锛屾敮鎸佸崰浣嶇鏇挎崲
      const message = this.uiTexts['tipBodyTooLong'].replace('{max}', MAX_BODY_LENGTH.toString())
      await this.systemService.showToast(message)
      hilog.warn(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG, 
        '鍐呭闀垮害瓒呴檺: %{public}d > %{public}d', bodyTrimmed.length, MAX_BODY_LENGTH)
      return
    }
    
    // 鉁?璁剧疆鍙戦€佷腑鐘舵€?    this.isSendingEmail = true
    
    try {
      await this.systemService.showLoading('侀朵腑...')
      
      // ===== 鉁?鑷畾涔夐偖绠变紭鍏堢骇妫€鏌?=====
      let fromEmail: string
      let fromName: string | undefined = undefined
      let useCustomMailbox = false
      let useSMTP = false  // 鏄惁跨SMTP      
      // 妫€鏌ョ敤鎴锋槸鍚﹀湪"鍐欓偖浠?椤甸潰閫夋嫨浜嗚嚜瀹氫箟閭
      if (this.composeFrom && this.composeFrom.startsWith('[畾涔塢')) {
        // 鐢ㄦ埛鏄庣‘閫夋嫨浜嗚嚜瀹氫箟閭
        hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG, 
          '跨畾涔卞彂侊紝姝ｅ湪楠岃瘉...')
        
        const validation = this.validateCustomMailboxConfig()
        
        if (validation.valid) {
          // 鉁?鑷畾涔夐偖绠遍厤缃畬鏁?          fromEmail = this.customMailboxEmail
          fromName = this.customMailboxDisplayName || undefined
          useCustomMailbox = true
          useSMTP = true  // 跨SMTP          
          hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG, 
            '跨畾涔SMTP') email=%{public}s, displayName=%{public}s','            this.customMailboxEmail.substring(0, 3) + '***',
            fromName || '(')
        } else {
          // 璀﹀憡锛氳嚜瀹氫箟閭閰嶇疆涓嶅畬鏁?          hilog.warn(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
            '畾涔遍厤笉屾暣: %{public}s', validation.missingFields.join(', '))
          
          await this.systemService.showToast(
            `﹀锛氳嚜箟畬碶n\n` +
            `缂哄皯: ${validation.missingFields.join(', '`)}\n\n` +`            `璇峰墠寰"璁剧"屽杽`
          )
          
          this.isSendingEmail = false
          return
        }
      } else {
        // 浣跨敤涓存椂閭
        fromEmail = this.composeFrom || this.currentMailbox.email || 'noreply@temp.mail'
        
        hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
          '跨椂 %{public}s', fromEmail)
      }
      // ===== 鑷畾涔夐偖绠变紭鍏堢骇妫€鏌ョ粨鏉?=====
      
      // 瑙ｆ瀽鍙戦€佹柟寮忕被鍨?      let senderType: EmailSenderType
      
      // 濡傛灉閫夋嫨浜嗚嚜瀹氫箟閭锛屽己鍒朵娇鐢⊿MTP
      if (useSMTP) {
        senderType = EmailSenderType.SMTP
        hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG, '寮哄埗跨SMTP佸櫒')
      } else {
        senderType = this.settingsSendMethod as EmailSenderType
      }
      
      // 鉁?鏃ュ織鑴辨晱锛氶殣钘忔晱鎰熶俊鎭?      const maskedTo = toTrimmed.replace(/(.{2}).*(@.*)/, '$1***$2')
      const maskedSubject = subjectTrimmed.length > 10 
         subjectTrimmed.substring(0, 10) + '...' 
        : '[查殣钘廬'
      hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG, 
        '鍑嗗侀 to=%{public}s, subject=%{public}s, from=%{public}s, senderType=%{public}s', 
        maskedTo, maskedSubject, fromEmail, senderType)
      
      // 璋冪敤缃戠粶鏈嶅姟鍙戦€侀偖浠讹紙浣跨敤鍘婚櫎绌烘牸鍚庣殑鍊硷級
      // 鉁?濡傛灉浣跨敤鑷畾涔夐偖绠憋紝浼犻€扴MTP閰嶇疆
      let smtpConfig: Record<string, string> | undefined = undefined
      
      if (useSMTP && useCustomMailbox) {
        // 鏋勫缓SMTP閰嶇疆
        smtpConfig = {
          'smtp_host': this.customMailboxSmtpHost,
          'smtp_port': this.customMailboxSmtpPort.toString(),
          'smtp_secure': this.customMailboxSmtpSecure  'true' : 'false',
          'smtp_user': this.customMailboxEmail,
          'smtp_pass': this.customMailboxPassword
        }
        
        hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
          'SMTP: host=%{public}s, port=%{public}d, secure=%{public}s',
          this.customMailboxSmtpHost,
          this.customMailboxSmtpPort,
          this.customMailboxSmtpSecure  'true' : 'false')
      }
      
      const result = await this.networkService.sendEmail(
        toTrimmed,
        subjectTrimmed,
        bodyTrimmed,
        senderType,
        smtpConfig,  // 浼犻扴MTP
        fromEmail,
        fromName  // 畾涔辩殑鏄剧鍚О锛屾垨 undefined
      )
      
      await this.systemService.hideLoading()
      
      // 鉁?淇濆瓨鍙戦€佽褰曪紙鏃犺鎴愬姛鎴栧け璐ワ級
      const sentRecord: SentEmailData = {
        id: Date.now(),
        from: fromEmail,
        to: toTrimmed,
        subject: subjectTrimmed,
        body: bodyTrimmed,
        sentTime: Date.now(),
        success: result.success,
        errorMessage: result.success ? undefined : result.error,
        attachments: this.composeAttachments.length > 0 ? this.composeAttachments : undefined  // 鉁闄勪伅
      }
      // 鉁?浣跨敤 MailboxManager 淇濆瓨鍙戦€佽褰?      this.mailboxManager.addSentEmail(sentRecord)
      
      // 鉁?閲嶆柊鍔犺浇鏁版嵁锛岃Е鍙慤I鏇存柊
      this.loadData()
      
      hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
