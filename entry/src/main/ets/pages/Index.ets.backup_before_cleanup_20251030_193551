  formatDate(date: Date): string {
    return `${date.getFullYear()}-${(date.getMonth() + 1).toString().padStart(2, '0')}-${date.getDate().toString().padStart(2, '0')}`
  }
  
  formatEmailTime(date: Date): string {
    const now = new Date()
    const diff = now.getTime() - date.getTime()
    const minutes = Math.floor(diff / 60000)
    const hours = Math.floor(diff / 3600000)
    const days = Math.floor(diff / 86400000)
    
    if (days > 0) return `${days}╁墠`
    if (hours > 0) return `${hours}忔椂鍓峘`    if (minutes > 0) return `${minutes}嗛挓鍓峘`    return '氬垰'
  }
  
  getMailboxStatus(mailbox: MailboxData): string {
    const now = new Date()
    const expiry = new Date(mailbox.expiryTime)
    
    if (expiry <= now) return '繃'    
    const diff = expiry.getTime() - now.getTime()
    const hours = diff / (1000 * 3600)
    
    if (hours <= 24) return ''
    return '娲昏穬'
  }
  
  /**
   * 鑾峰彇閭鐨勭姸鎬佹寚绀哄櫒锛堟寜鏃堕棿鎺掑簭锛?   */
  getStatusIndicators(mailbox: MailboxData): StatusIndicator[] {
    const indicators: StatusIndicator[] = []
    
    if (mailbox.isPinned && mailbox.pinnedTime) {
      // 鉁?鏄惧紡鎸囧畾绫诲瀷锛岄伩鍏?arkts-no-obj-literals-as-types 閿欒
      const pinIndicator: StatusIndicator = {
        type: 'pin',
        time: mailbox.pinnedTime,
        color: '#2196F3'
      }
      indicators.push(pinIndicator)
    }
    
    if (mailbox.isBlocked && mailbox.blockedTime) {
      // 鉁?鏄惧紡鎸囧畾绫诲瀷锛岄伩鍏?arkts-no-obj-literals-as-types 閿欒
      const blockIndicator: StatusIndicator = {
        type: 'block',
        time: mailbox.blockedTime,
        color: '#F44336'
      }
      indicators.push(blockIndicator)
    }
    
    // 鎸夋椂闂存帓搴忥紙鏃╃殑鍦ㄥ墠锛?    indicators.sort((a, b) => a.time - b.time)
    
    return indicators
  }
  
