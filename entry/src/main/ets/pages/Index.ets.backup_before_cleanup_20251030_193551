    if (sectionId === 'interface') {
      return this.uiTexts['settingsInterface']
    } else if (sectionId === 'mailbox') {
      return this.uiTexts['settingsMailboxSettings']
    } else if (sectionId === 'emailSend') {
      return this.uiTexts['settingsEmailSend']
    } else if (sectionId === 'customMailbox') {
      return this.uiTexts['settingsCustomMailbox'] || '畾涔遍厤'    } else if (sectionId === 'serviceConfig') {
      return this.uiTexts['settingsServiceConfig']
    } else if (sectionId === 'autoCheck') {
      return this.uiTexts['settingsAutoCheck']
    } else if (sectionId === 'notification') {
      return this.uiTexts['settingsNotification']
    } else if (sectionId === 'advancedFeatures') {
      return '[楂樼骇] ' + this.uiTexts['advancedFeatures']
    }
    return ''
  }

