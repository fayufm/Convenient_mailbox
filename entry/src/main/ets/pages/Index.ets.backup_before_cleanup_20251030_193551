  loadData() {
    const mailboxes = this.mailboxManager.getMailboxes()
    
    // 排序：置顶的在前，按置顶时间倒序；未置顶的按创建时间倒序
    const sortedMailboxes: MailboxData[] = []
    
    // ✅ 手动复制每个邮箱对象到新数组（确保完全新的引用）
    for (let i = 0; i < mailboxes.length; i++) {
      sortedMailboxes.push(mailboxes[i])
    }
    
    // 排序
    sortedMailboxes.sort((a, b) => {
      // 置顶的优先
      if (a.isPinned && !b.isPinned) return -1
      if (!a.isPinned && b.isPinned) return 1
      
      // 都置顶或都未置顶，按时间排序
      if (a.isPinned && b.isPinned) {
        return (b.pinnedTime || 0) - (a.pinnedTime || 0)
      }
      
      return b.createdTime - a.createdTime
    })
    
    // ✅ 直接赋值新数组，触发 @State 响应
    this.mailboxes = sortedMailboxes
    
    // 同样处理 emails
    const emailsArray: EmailData[] = []
    const emails = this.mailboxManager.getEmails()
    for (let i = 0; i < emails.length; i++) {
      emailsArray.push(emails[i])
    }
    this.emails = emailsArray
    
    // ✅ 加载已发送邮件
    const sentEmailsArray: SentEmailData[] = []
    const sentEmails = this.mailboxManager.getSentEmails()
    for (let i = 0; i < sentEmails.length; i++) {
      sentEmailsArray.push(sentEmails[i])
    }
    this.sentEmails = sentEmailsArray
    
    // 🆕 加载搜索历史 @since v1.0.1
    const searchHistoryArray: string[] = []
    const history = this.mailboxManager.getSearchHistory()
    for (let i = 0; i < history.length; i++) {
      searchHistoryArray.push(history[i])
    }
    this.searchHistory = searchHistoryArray
    
    this.currentMailbox = this.mailboxManager.getCurrentMailbox()
    
    // ✅ 强制刷新UI：递增刷新计数器
    this.mailboxListRefreshKey++
    this.emailListRefreshKey++
    this.sentEmailListRefreshKey++  // ✅ 也要刷新发件箱
    // 注意：statsRefreshKey 会在 updateStats() 中自动递增
    
    // ✅ 更新统计数据（必须在数据加载完成后调用）
    this.updateStats()
    
    hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
      `loadData完成: ${this.mailboxes.length}个邮箱, ${this.emails.length}封邮件, refreshKeys: mailbox=${this.mailboxListRefreshKey}, email=${this.emailListRefreshKey}, stats=${this.statsRefreshKey}, 统计: 总=${this.totalEmails}, 未读=${this.unreadEmails}, 今日=${this.todayEmails}`)
    
    // 初始化发件邮箱选择（选择第一个邮箱）
    if (this.mailboxes.length > 0 && !this.composeFrom) {
      this.composeFrom = this.mailboxes[0].email
      this.composeFromIndex = 0
      hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG, 
        `初始化发件邮箱: ${this.composeFrom}`)
    }
    
    // 初始化域名选择索引
    this.selectedDomainIndex = this.calculateDomainIndex()
    hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG, 
      `初始化域名选择: ${this.selectedDomain}, index=${this.selectedDomainIndex}`)
  }
  
  /**
   * 🔧 自动修正功能冲突和不合理配置
   * 在应用启动时检查并修正可能导致性能问题的配置
   */
  async autoFixFeatureConflicts() {
    try {
      // 统计启用的功能数量
      const enabledFeatures = [
        this.enableEmailSearch,
        this.enableTemplates,
        this.enableFolders,
        this.enableStatistics,
        this.enableTags,
        this.enableAutoCategory,
        this.enableDataVisualization,
        this.enableAdvancedBackup,
        this.enableFAB
      ].filter(enabled => enabled).length
      
      hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
        '🔍 功能配置检查: 当前启用 %{public}d/9 个功能', enabledFeatures)
      
      // 如果启用了所有9个功能，自动降级到推荐配置
      if (enabledFeatures === 9) {
        hilog.warn(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
          '⚠️ 检测到所有功能都已启用，自动降级到推荐配置以避免性能问题')
        
        // 自动关闭高性能消耗的功能
        this.enableTags = false
        this.enableAutoCategory = false
        this.enableDataVisualization = false
        this.enableAdvancedBackup = false
        this.enableFAB = false
        
        // 保存修正后的设置
        await this.mailboxManager.updateSettings({
          enableEmailSearch: this.enableEmailSearch,
          enableTemplates: this.enableTemplates,
          enableFolders: this.enableFolders,
          enableStatistics: this.enableStatistics,
          enableTags: this.enableTags,
          enableAutoCategory: this.enableAutoCategory,
          enableDataVisualization: this.enableDataVisualization,
          enableAdvancedBackup: this.enableAdvancedBackup,
          enableFAB: this.enableFAB
        })
        
        hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
          '✅ 已自动修正为推荐配置: 启用搜索+模板+分组+统计')
        
        // 提示用户
        setTimeout(() => {
          promptAction.showToast({
            message: '已自动优化功能配置，提升应用性能',
            duration: 3000
          })
        }, 1000)
        
        return
      }
      
      // 如果启用了7-8个功能，也进行警告
      if (enabledFeatures >= 7) {
        hilog.warn(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
          '⚠️ 检测到启用了 %{public}d 个功能，可能影响性能', enabledFeatures)
        
        // 检查是否同时启用了数据可视化和智能分类（高性能消耗组合）
        if (this.enableDataVisualization && this.enableAutoCategory) {
          hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
            '🔧 检测到数据可视化和智能分类同时启用，自动关闭数据可视化')
          
          this.enableDataVisualization = false
          
          await this.mailboxManager.updateSettings({
            enableDataVisualization: false
          })
          
          setTimeout(() => {
            promptAction.showToast({
              message: '已自动关闭数据可视化功能以优化性能',
              duration: 2500
            })
          }, 1000)
        }
      }
      
      hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
        '✅ 功能配置检查完成')
      
    } catch (error) {
      hilog.error(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
        '功能突修正失败: %{public}s', JSON.stringify(error))
    }
  }
  
