  getCurrentEmails(): EmailData[] {
    // 鉁?淇锛氭敹浠剁鏄剧ず鎵€鏈夐偖绠辩殑閭欢锛屼笉闇€瑕侀€夋嫨閭
    let result = this.emails
    
    // 馃啎 搴旂敤鎼滅储鍜岃繃婊?@since v1.0.1
    if (this.enableEmailSearch) {
      // 1. 鍏抽敭璇嶆悳绱?      if (this.searchKeyword.length > 0) {
        const keyword = this.searchKeyword.toLowerCase()
        result = result.filter(email => {
          // 鎼滅储鍙戜欢浜?          if (email.from && email.from.toLowerCase().includes(keyword)) {
            return true
          }
          // 鎼滅储涓婚
          if (email.subject && email.subject.toLowerCase().includes(keyword)) {
            return true
          }
          // 鎼滅储鍐呭
          if (email.body && email.body.toLowerCase().includes(keyword)) {
            return true
          }
          return false
        })
      }
      
      // 2. 鐘舵€佺瓫閫?      if (this.filterStatus === 'unread') {
        result = result.filter(email => !email.isRead)
      } else if (this.filterStatus === 'read') {
        result = result.filter(email => email.isRead)
      }
      
      // 3. 鎺掑簭
      if (this.sortBy === 'time') {
        result.sort((a, b) => {
          const timeA = Number(a.receivedTime) || 0
          const timeB = Number(b.receivedTime) || 0
          return this.sortOrder === 'desc'  timeB - timeA : timeA - timeB
        })
      } else if (this.sortBy === 'sender') {
        result.sort((a, b) => {
          const senderA = (a.from || '').toLowerCase()
          const senderB = (b.from || '').toLowerCase()
          if (this.sortOrder === 'desc') {
            return senderB.localeCompare(senderA)
          } else {
            return senderA.localeCompare(senderB)
          }
        })
      }
    }
    
    // 馃啎 鏍囩绛涢€?@since v1.0.1
    if (this.enableTags && this.filterByTagId > 0) {
      result = result.filter(email => {
        return email.tags && email.tags.includes(this.filterByTagId)
      })
    }
    
    // 馃啎 鍒嗙被绛涢€?@since v1.0.1
    if (this.enableAutoCategory && this.categoryFilter !== 'all') {
      result = result.filter(email => {
        if (this.categoryFilter === 'verification') {
          return email.category === EmailCategory.VERIFICATION
        } else if (this.categoryFilter === 'transaction') {
          return email.category === EmailCategory.TRANSACTION
        } else if (this.categoryFilter === 'social') {
          return email.category === EmailCategory.SOCIAL
        } else if (this.categoryFilter === 'promotion') {
          return email.category === EmailCategory.PROMOTION
        } else if (this.categoryFilter === 'notification') {
          return email.category === EmailCategory.NOTIFICATION
        } else if (this.categoryFilter === 'other') {
          return email.category === EmailCategory.OTHER || !email.category
        }
        return true
      })
    }
    
    return result
  }
  
  /**
   * 馃啎 搴旂敤閭欢鎼滅储鍜岃繃婊?   * 鏇存柊杩囨护缁撴灉璁℃暟锛屼繚瀛樻悳绱㈠巻鍙?   * @since v1.0.1
   */
  applyEmailSearch() {
    // 鏇存柊杩囨护鍚庣殑閭欢鏁伴噺
    const filtered = this.getCurrentEmails()
    this.filteredEmailCount = filtered.length
    
    // 淇濆瓨鎼滅储鍘嗗彶锛堥潪绌哄叧閿瘝锛?    if (this.searchKeyword.length > 0 && this.searchKeyword.trim().length > 0) {
      const trimmedKeyword = this.searchKeyword.trim()
      
      // 妫€鏌ユ槸鍚﹀凡瀛樺湪
      const existingIndex = this.searchHistory.indexOf(trimmedKeyword)
      if (existingIndex !== -1) {
        // 濡傛灉宸插瓨鍦紝绉诲埌鏈€鍓嶉潰
        this.searchHistory.splice(existingIndex, 1)
      }
      
      // 娣诲姞鍒板巻鍙茶褰曟渶鍓嶉潰
      this.searchHistory.unshift(trimmedKeyword)
      
      // 闄愬埗鍘嗗彶璁板綍鏁伴噺涓?0鏉?      if (this.searchHistory.length > 10) {
        this.searchHistory = this.searchHistory.slice(0, 10)
      }
      
      // 淇濆瓨鍒?MailboxManager
      this.mailboxManager.addSearchHistory(trimmedKeyword)
      
      hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
        '鎼储鍏抽敭璇凡: %{public}s, 褰撳墠鍘嗗彶璁板綍 %{public}d',
        trimmedKeyword, this.searchHistory.length)
    }
    
    hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
      '鎼储插簲 鍏抽敭璇%{public}s, 鐘%{public}s, 鎺簭=%{public}s %{public}s, 缁撴%{public}d',
      this.searchKeyword || '(',
      this.filterStatus,
      this.sortBy,
      this.sortOrder,
      this.filteredEmailCount)
  }
  
  /**
   * 馃啎 鑾峰彇杩囨护鍚庣殑妯℃澘鍒楄〃
   * 鏍规嵁鍒嗙被绛涢€夛紝鏀惰棌鐨勬帓鍦ㄥ墠闈?   * @since v1.0.1
   */
  getFilteredTemplates(): EmailTemplate[] {
    let templates = this.mailboxManager.getTemplates()
    
    // 鍒嗙被绛涢€?    if (this.templateCategoryFilter !== 'all') {
      templates = templates.filter(t => {
        if (this.templateCategoryFilter === 'business') {
          return t.category === TemplateCategory.BUSINESS
        } else if (this.templateCategoryFilter === 'personal') {
          return t.category === TemplateCategory.PERSONAL
        } else if (this.templateCategoryFilter === 'verification') {
          return t.category === TemplateCategory.VERIFICATION
        } else if (this.templateCategoryFilter === 'custom') {
          return t.category === TemplateCategory.CUSTOM
        }
        return true
      })
    }
    
    // 鎺掑簭锛氭敹钘忕殑鍦ㄥ墠锛岀劧鍚庢寜浣跨敤娆℃暟鎺掑簭
    templates.sort((a, b) => {
      if (a.isFavorite && !b.isFavorite) return -1
      if (!a.isFavorite && b.isFavorite) return 1
      return b.useCount - a.useCount
    })
    
    return templates
  }
  
