  /**
   * 鏍规嵁鏁伴噺鑾峰彇鎸囩ず鍣ㄧ嚎鏉℃鏁?   * 1-7涓細鏄剧ず瀵瑰簲娈垫暟
   * 8+锛氭樉绀哄浐瀹?娈?   */
  getIndicatorSegments(count: number): number {
    if (count <= 0) return 0
    if (count <= 7) return count  // 1-7細鏄剧為檯娈垫暟
    return 7  // 8互婏細缁熶竴鏄剧7娈碉紙氳繃棰滆壊鍖哄垎锛  }
  
  /**
   * 鏍规嵁鏁伴噺鑾峰彇鎸囩ず鍣ㄩ鑹?   * 1-7: 缁胯壊 (#4CAF50) - 姝ｅ父
   * 8-9: 榛勮壊 (#FFC107) - 娉ㄦ剰
   * 10-24: 绱壊 (#9C27B0) - 杈冨
   * 25-49: 绾㈣壊 (#F44336) - 璀﹀憡
   * 50-99: 鐏拌壊 (#757575) - 涓ラ噸
   * 100+: 榛戣壊 (#212121) - 鏋佺
   */
  getIndicatorColor(count: number): string {
    if (count >= 100) return '#212121'  // 榛戣壊
    if (count >= 50) return '#757575'   // 鐏拌壊
    if (count >= 25) return '#F44336'   // 绾㈣壊
    if (count >= 10) return '#9C27B0'   // 绱壊
    if (count >= 8) return '#FFC107'    // 榛勮壊
    return '#4CAF50'                     // 缁胯壊锛-7锛  }
  
