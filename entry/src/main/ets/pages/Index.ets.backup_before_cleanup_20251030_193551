  /**
   * 閫夋嫨闄勪欢
   */
  async onSelectAttachment() {
    try {
      // 妫€鏌ラ檮浠舵暟閲忛檺鍒讹紙鏈€澶?涓級
      if (this.composeAttachments.length >= 5) {
        await this.systemService.showToast(this.uiTexts['tipMaxAttachments'])
        return
      }
      
      hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG, '寮濮嬮囦...')
      
      // 鉁?浣跨敤 HarmonyOS 鏂囦欢閫夋嫨鍣?      const documentPicker = new picker.DocumentViewPicker()
      const documentSelectOptions: picker.DocumentSelectOptions = {
        maxSelectNumber: 5 - this.composeAttachments.length,  // 鍓╀綑暟閲      }
      
      try {
        const documentSelectResult = await documentPicker.select(documentSelectOptions)
        
        if (!documentSelectResult || !documentSelectResult.length || documentSelectResult.length === 0) {
          hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG, '栨秷嗘枃堕')
          return
        }
        
        hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG, 
          '%{public}d 枃, documentSelectResult.length')
        
        // 澶勭悊閫変腑鐨勬枃浠?        for (let i = 0; i < documentSelectResult.length; i++) {
          const fileUri = documentSelectResult[i]
          
          try {
            // 鑾峰彇鏂囦欢淇℃伅
            const file = fs.openSync(fileUri, fs.OpenMode.READ_ONLY)
            const stat = fs.statSync(fileUri)
            
            // 鑾峰彇鏂囦欢鍚?            const pathParts = fileUri.split('/')
            const filename = pathParts[pathParts.length - 1] || `file_${Date.now()}`
            
            // 妫€鏌ユ枃浠跺ぇ灏忥紙闄愬埗10MB锛?            if (stat.size > 10 * 1024 * 1024) {
              await this.systemService.showToast(this.uiTexts['tipFileTooLarge'].replace('{filename}', filename))
              fs.closeSync(file)
              continue
            }
            
            // 鍒涘缓闄勪欢瀵硅薄
            const attachment: AttachmentData = {
              id: Date.now().toString() + '_' + i,
              filename: filename,
              size: stat.size,
              contentType: this.getFileMimeType(filename),
              localPath: fileUri
            }
            
            this.composeAttachments.push(attachment)
            
            hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
              '娣姞闄勪: %{public}s, : %{public}d, : %{public}s', 
              attachment.filename, attachment.size, attachment.contentType)
            
            fs.closeSync(file)
            
          } catch (fileError) {
            const err = fileError as Error
            hilog.error(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
              '勭悊囦辫触: %{public}s', err.message)
          }
        }
        
        if (this.composeAttachments.length > 0) {
          await this.systemService.showToast(this.uiTexts['tipAttachmentsAdded'].replace('{count}', documentSelectResult.length.toString()))
        }
        
      } catch (pickerError) {
        const err = pickerError as Error
        // 鐢ㄦ埛鍙栨秷閫夋嫨涓嶇畻閿欒
        if (err.message && err.message.includes('cancel')) {
          hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG, '栨秷嗘枃堕')
          return
        }
        throw err
      }
      
    } catch (error) {
      const err = error as Error
      hilog.error(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
        '闄勪辫触: %{public}s', err.message)
      await this.systemService.showToast(this.uiTexts['tipSelectAttachmentFailed'] + err.message)
    }
  }
  
