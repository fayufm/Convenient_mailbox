  /**
   * 鍔犺浇鍚庣浠ｇ悊閰嶇疆
   */
  async loadProxyConfig() {
    try {
      const config = await this.emailConfigManager.getProxyConfig()
      this.proxyEnabled = config.enabled
      this.proxyBaseUrl = config.baseUrl
      this.proxyAuthToken = config.authToken || ''
      this.proxyTimeout = config.timeout
      
      hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
        '鍚庣ｇ悊插姞杞 %{public}s', config.enabled  '插 : '')'    } catch (error) {
      const err = error as Error
      hilog.error(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
        'ｇ悊辫触: %{public}s', err.message)
      await this.systemService.showToast(this.uiTexts['tipLoadConfigFailed'])
    }
  }
  
  /**
   * 淇濆瓨鍚庣浠ｇ悊閰嶇疆
   */
  async saveProxyConfig() {
    try {
      // 楠岃瘉閰嶇疆
      const config: ProxyServerConfig = {
        enabled: this.proxyEnabled,
        baseUrl: this.proxyBaseUrl || '',
        authToken: this.proxyAuthToken || '',
        timeout: this.proxyTimeout
      }
      
      const validation = await this.emailConfigManager.validateProxyConfig(config)
      if (!validation.valid) {
        await this.systemService.showToast(validation.error || '楠岃瘉辫触')
        return
      }
      
      // 淇濆瓨閰嶇疆
      const success = await this.emailConfigManager.saveProxyConfig(config)
      if (success) {
        await this.systemService.showToast(this.uiTexts['tipConfigSaveSuccess'])
        this.proxyTestResult = ''  // 娓呴櫎娴瘯缁撴
        hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG, '鍚庣ｇ悊蹭繚瀛')
      } else {
        await this.systemService.showToast(this.uiTexts['tipConfigSaveFailed'])
      }
    } catch (error) {
      const err = error as Error
      hilog.error(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
        'ｇ悊辫触: %{public}s', err.message)
      await this.systemService.showToast(this.uiTexts['tipSaveProxyFailed'] + err.message)
    }
  }
  
  /**
   * 娴嬭瘯鍚庣浠ｇ悊杩炴帴
   */
  async testProxyConnection() {
    if (!this.proxyBaseUrl) {
      this.proxyTestResult = '[辫触] 璇峰厛杈撳叆ㄥ鍧'
      await this.systemService.showToast(this.uiTexts['tipEnterServerUrl'])
      return
    }
    
    try {
      this.proxyTestResult = '[娴瘯璢 姝ｅ湪炴帴..'
      await this.systemService.showLoading('娴瘯..')
      
      const config: ProxyServerConfig = {
        enabled: true,
        baseUrl: this.proxyBaseUrl || '',
        authToken: this.proxyAuthToken || '',
        timeout: this.proxyTimeout
      }
      
      const result = await this.emailConfigManager.testProxyConnection(config)
      
      await this.systemService.hideLoading()
      
      if (result.success) {
        this.proxyTestResult = `[成功] ${result.message}\n服务器：${this.proxyBaseUrl}\n连接时间：${new Date().toLocaleTimeString()}`
        await this.systemService.showToast(this.uiTexts['tipConnectionSuccess'])
      } else {
        this.proxyTestResult = `[辫触] ${result.message}`
        await this.systemService.showToast(this.uiTexts['tipConnectionFailed'])
      }
      
      hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
        '代理连接测试结果: %{public}s', result.success ? '成功' : '失败')
    } catch (error) {
      await this.systemService.hideLoading()
      this.proxyTestResult = `[失败] 测试失败：${(error as Error).message}`
      await this.systemService.showToast(this.uiTexts['tipTestFailed'] + error.message)
      
      const err = error as Error
      hilog.error(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
        'ｇ悊炴帴娴瘯辫触: %{public}s', err.message)
    }
  }
}
