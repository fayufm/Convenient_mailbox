          }
          .width('100%')
          .padding(12)
          .backgroundColor($r('app.color.card_background'))
          .borderRadius(8)
          .onClick(() => {
            // 鍒囨崲灞曞紑鐘舵€?            const index = this.expandedFolderIds.indexOf(-1)
            if (index !== -1) {
              this.expandedFolderIds.splice(index, 1)
            } else {
              this.expandedFolderIds.push(-1)
            }
            this.expandedFolderIds = [...this.expandedFolderIds]
          })
          
          // 鏈垎缁勯偖绠卞垪琛?          if (this.expandedFolderIds.includes(-1)) {
            ForEach(this.mailboxes.filter(m => !m.folderId), (mailbox: MailboxData) => {
