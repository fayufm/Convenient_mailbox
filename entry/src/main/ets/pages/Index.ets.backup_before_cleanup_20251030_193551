  async onLoadDraft() {
    try {
      const drafts = this.mailboxManager.getDrafts()
      
      if (drafts.length === 0) {
        await this.systemService.showToast(this.uiTexts['tipNoDraft'])
        return
      }
      
      // 鍔犺浇鏈€鏂扮殑鑽夌
      const latestDraft = drafts[drafts.length - 1]
      
      this.composeTo = latestDraft.to
      this.composeSubject = latestDraft.subject
      this.composeBody = latestDraft.body
      this.composeAttachments = latestDraft.attachments || []  // 鉁鎭㈠闄勪
      this.hasDraft = true
      
      // 鉁?鎭㈠鍙戜欢閭閫夋嫨
      if (latestDraft.from) {
        this.composeFrom = latestDraft.from
        // 鏌ユ壘瀵瑰簲鐨勭储寮?        const options = this.getMailboxSelectOptions()
        const foundIndex = options.findIndex(o => o.value === latestDraft.from)
        if (foundIndex >= 0) {
          this.composeFromIndex = foundIndex
        }
      }
      
      await this.systemService.showToast(this.uiTexts['tipDraftLoaded'])
    } catch (error) {
      await this.systemService.showToast(this.uiTexts['tipLoadDraftFailed'])
    }
  }
  
