  /**
   * 妫€鏌ヨ嚜瀹氫箟閭閰嶇疆鏄惁瀹屾暣
   * @returns CustomMailboxValidationResult 楠岃瘉缁撴灉
   */
  validateCustomMailboxConfig(): CustomMailboxValidationResult {
    const missingFields: string[] = []
    
    if (!this.customMailboxEmail || this.customMailboxEmail.trim().length === 0) {
      missingFields.push(this.uiTexts['customMailboxEmail'] || '鍦板潃')
    }
    
    if (!this.customMailboxPassword || this.customMailboxPassword.trim().length === 0) {
      missingFields.push(this.uiTexts['customMailboxPassword'] || '瀵嗙爜')
    }
    
    if (!this.customMailboxSmtpHost || this.customMailboxSmtpHost.trim().length === 0) {
      missingFields.push('SMTP')
    }
    
    if (!this.customMailboxImapHost || this.customMailboxImapHost.trim().length === 0) {
      missingFields.push('IMAP')
    }
    
    if (this.customMailboxSmtpPort <= 0 || this.customMailboxSmtpPort > 65535) {
      missingFields.push('SMTP绔彛锛-65535锛')
    }
    
    if (this.customMailboxImapPort <= 0 || this.customMailboxImapPort > 65535) {
      missingFields.push('IMAP绔彛锛-65535锛')
    }
    
    // 鉁?鍩烘湰閭鍦板潃鏍煎紡楠岃瘉锛堜娇鐢ㄦ洿涓ユ牸鐨勯獙璇侊級
    if (this.customMailboxEmail && this.customMailboxEmail.trim().length > 0) {
      if (!this.validateEmailFormat(this.customMailboxEmail)) {
        missingFields.push('鍦板潃鏍煎紡犳晥锛堥渶绗﹀悎鏍囧噯鏍煎紡锛')
      }
    }
    
    const valid = missingFields.length === 0
    
    if (!valid) {
      hilog.warn(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
        '畾涔遍厤笉屾暣锛岀己 %{public}s', missingFields.join(', '))
    }
    
    // 鉁?杩斿洖鏄庣‘鐨勬帴鍙ｇ被鍨?    const result: CustomMailboxValidationResult = {
      valid: valid,
      missingFields: missingFields
    }
    return result
  }
  
