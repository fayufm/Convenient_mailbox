          'smtp_host': this.customMailboxSmtpHost,
          'smtp_port': this.customMailboxSmtpPort.toString(),
          'smtp_secure': this.customMailboxSmtpSecure  'true' : 'false',
          'smtp_user': this.customMailboxEmail,
          'smtp_pass': this.customMailboxPassword
        }
        
        // 鍙戦€佹祴璇曢偖浠?        const testResult = await this.networkService.sendEmail(
          this.customMailboxEmail,  // 戠粰繁
          '炴帴娴瘯 - Connection Test',
          `欐槸嚜祴璇曢讹紝ㄤ簬楠岃瘉SMTP厤俓n椂达細${new Date().toLocaleString()}\n\nThis is an automatic test email to verify SMTP server configuration.\nSent at: ${new Date().toLocaleString()}`,
          EmailSenderType.SMTP,
          smtpConfig,
          this.customMailboxEmail,
          this.customMailboxDisplayName || undefined
        )
        
        smtpSuccess = testResult.success
        smtpError = testResult.error || ''
        
        hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
          'SMTP娴瘯缁撴: %{public}s, error=%{public}s',
          smtpSuccess  '愬姛' : '辫触', smtpError)
      } catch (error) {
        const err = error as Error
        smtpError = err.message
        hilog.error(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
          'SMTP娴瘯寮傚父: %{public}s', err.message)
      }
      
      await this.systemService.hideLoading()
      
      // 鏄剧ず娴嬭瘯缁撴灉
      if (smtpSuccess) {
        await this.systemService.showToast(
          '鉁炴帴娴瘯愬姛锛乗n\n' +
          'SMTPㄨ繛鎺ユ甯竆n' +
          '插彂祴璇曢埌ㄧ殑\n\n' +
          'ㄧ鍦ㄥ彲ヤ侀'        )
      } else {
        await this.systemService.showToast(
          '鉂炴帴娴瘯辫触\n\n' +
          'SMTPㄨ繛鎺ュけ璐n' +
          `閿欒伅锛{smtpError}\n\n` +
          '璇ユ湇″櫒鍦板潃銆佺ｅ拰瀵嗙爜鏄惁姝ｇ‘'
        )
      }
    } catch (error) {
      const err = error as Error
      await this.systemService.hideLoading()
      hilog.error(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
        '娴瘯炴帴寮傚父: %{public}s', err.message)
      await this.systemService.showToast(`娴瘯辫触锛{err.message}`)
    }
  }
  
