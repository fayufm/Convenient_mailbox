  @Builder buildFolderView(): void {
    Column({ space: 12 }) {
      // 閬嶅巻鎵€鏈夋枃浠跺す
      ForEach(this.mailboxManager.getFolders(), (folder: MailboxFolder) => {
        this.buildFolderItem(folder)
      }, (folder: MailboxFolder) => folder.id.toString())
      
      // 鏈垎缁勭殑閭
      if (this.mailboxes.filter(m => !m.folderId).length > 0) {
        Column({ space: 12 }) {
          // 鏈垎缁勬爣棰?          Row({ space: 8 }) {
          Text('[囦筣')
