  /**
   * 妫€鏌ュ嵆灏嗚繃鏈熺殑閭骞跺彂閫侀€氱煡
   */
  async checkExpiringMailboxes() {
    if (!this.settingsExpiryNotification) return
    
    try {
      const now = Date.now()
      const oneDayMs = 24 * 60 * 60 * 1000
      const expiringMailboxes = this.mailboxes.filter(mailbox => {
        const timeUntilExpiry = mailbox.expiryTime - now
        // 閭鍦?4灏忔椂鍐呰繃鏈?        return timeUntilExpiry > 0 && timeUntilExpiry <= oneDayMs
      })
      
      if (expiringMailboxes.length > 0) {
        const notifOptions: NotificationOptions = {
          title: this.settingsLanguage === 'zh-CN'  '' : 'Mailbox Expiring Soon',
          text: this.settingsLanguage === 'zh-CN'
             ` ${expiringMailboxes.length} 卞鍦4忔椂鍐呰繃焋`            : `${expiringMailboxes.length} mailbox${expiringMailboxes.length > 1  'es' : ''} will expire within 24 hours`,
          additionalText: expiringMailboxes[0].email
        }
        
        // 鍙戦€侀€氱煡
        if (this.settingsDesktopNotification) {
          await this.systemService.sendNotification(notifOptions)
        }
        
        // 鎾斁閫氱煡澹伴煶
        if (this.settingsNotificationSound) {
          await this.systemService.playNotificationSound()
        }
        
        hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
          '愰啋插彂 %{public}d , expiringMailboxes.length')
      }
    } catch (error) {
      const err = error as Error
      hilog.error(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
        'ヨ繃熼卞け璐 %{public}s', err.message)
    }
  }
  
  async onEmailClick(email: EmailData) {
    // 鉁?淇锛氱偣鍑绘椂鑾峰彇瀹屾暣閭欢鍐呭
    if (!email.body || email.body === '') {
      try {
        await this.systemService.showLoading('鍐呭...')
        
        // 鏍规嵁閭鍩熷悕鑾峰彇provider
        const mailbox = this.mailboxes.find(m => m.id === email.mailboxId)
        if (mailbox) {
          const domain = mailbox.email.split('@')[1]
          const provider = this.mailboxManager.getProviderFactory().getProviderByDomain(domain)
          
          hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
            '鑾峰彇鍐呭: emailId=%{public}d, mailbox=%{public}s',
            email.id, mailbox.email)
          
          const response = await provider.getEmailContent(mailbox.email, email.id)
          
          if (response.success && response.data) {
            // 鏇存柊閭欢鍐呭
            email.body = response.data.body || response.data.textBody || response.data.htmlBody || ''
            hilog.info(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
              '愬姛鑾峰彇鍐呭锛岄暱搴 %{public}d', email.body.length)
          } else {
            hilog.warn(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
              '鑾峰彇鍐呭辫触: %{public}s', response.error || '閿欒')
          }
        }
        
        await this.systemService.hideLoading()
      } catch (error) {
        const err = error as Error
        await this.systemService.hideLoading()
        hilog.error(AppConstants.LOG_DOMAIN, AppConstants.LOG_TAG,
          '鑾峰彇鍐呭寮傚父: %{public}s', err.message)
      }
    }
    
    if (!email.isRead) {
      this.mailboxManager.markEmailAsRead(email.id)
      this.loadData()
      this.updateStats()
      this.updateBadges()
    }
    
    // 鎵撳紑閭欢璇︽儏
    this.selectedEmail = email
    this.showEmailDetail = true
  }
  
